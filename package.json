{
  "type": "module",
  "name": "omp-webui",
  "version": "0.1.0",
  "private": false,
  "description": "Headless management layer for omp \u2014 sessions, secrets, cron, browser terminal",
  "homepage": "https://omp.sh",
  "license": "MIT",
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun run build:server && bun run build:web",
    "build:server": "bun build src/index.ts --outdir=dist --target=bun --minify",
    "build:web": "bunx vite build",
    "check": "tsc --noEmit",
    "check:types": "tsc --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "bun test --parallel"
  },
  "dependencies": {
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^8.1.4"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zarguell/omp-webui.git"
  },
  "bugs": {
    "url": "https://github.com/zarguell/omp-webui/issues"
  },
  "author": "zarguell"
}
