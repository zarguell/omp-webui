{
	"type": "module",
	"name": "@oh-my-pi/omp-webui",
	"version": "0.1.0",
	"private": true,
	"description": "Headless management layer for omp — sessions, secrets, cron, browser terminal",
	"homepage": "https://omp.sh",
	"license": "MIT",
	"scripts": {
		"dev": "bun src/index.ts",
		"build": "bun run build:server && bun run build:web",
		"build:server": "bun build src/index.ts --outdir=dist --target=bun --minify",
		"build:web": "bunx vite build",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write .",
		"test": "bun test --parallel"
	},
	"dependencies": {
		"@oh-my-pi/pi-catalog": "workspace:*",
		"@oh-my-pi/pi-natives": "workspace:*",
		"@oh-my-pi/pi-utils": "workspace:*",
		"cron-parser": "^5.5.0",
		"cronstrue": "^3.5.0",
		"ghostty-web": "catalog:",
		"lucide-react": "catalog:",
		"marked": "18.0.10",
		"node-pty": "1.1.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"xterm": "^5.3.0",
		"xterm-addon-fit": "^0.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "^6.0.0",
		"vite": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
