{
	"type": "module",
	"name": "@oh-my-pi/omp-webui",
	"version": "0.1.0",
	"private": true,
	"description": "Headless management layer for omp — sessions, secrets, cron, browser terminal",
	"homepage": "https://omp.sh",
	"license": "MIT",
	"scripts": {
		"dev": "bun src/index.ts",
		"build": "bun run build:server && bun run build:web",
		"build:server": "bun build src/index.ts --outdir=dist --target=bun --minify",
		"build:web": "bunx vite build",
		"check": "biome check . && bun run check:types",
		"check:types": "bunx @typescript/native-preview --noEmit -p tsconfig.json",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write .",
		"test": "bun test --parallel"
	},
	"dependencies": {
		"cron-parser": "^5.5.0",
		"cronstrue": "^3.5.0",
		"ghostty-web": "0.4.0",
		"lucide-react": "^1.32.0",
		"marked": "18.0.10",
		"node-pty": "1.1.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"xterm": "^5.3.0",
		"xterm-addon-fit": "^0.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.5",
		"vite": "^8.2.1"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
